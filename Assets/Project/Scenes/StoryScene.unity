    - target: {fileID: 4478153447547633519, guid: ca67ab3bea54e2742b915855d05d3155, type: 3}
      propertyPath: _dialogueLines.Array.data[9]._name
      value: "\uB2D0 \uBE0C\uB8E9\uC2A4"
      objectReference: {fileID: 0}
    - target: {fileID: 4478153447547633519, guid: ca67ab3bea54e2742b915855d05d3155, type: 3}
      propertyPath: _dialogueLines.Array.data[0]._dialogue
      value: "\uB05D\uB0AC\uB2E4. \uC800 \uC18C\uB984\uB07C\uCE58\uACE0 \uB054\uCC0D\uD55C
        \uC9D1\uC5D0\uC11C \uB098\uB294 \uD0C8\uCD9C\uD588\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4478153447547633519, guid: ca67ab3bea54e2742b915855d05d3155, type: 3}
      propertyPath: _dialogueLines.Array.data[1]._dialogue
      value: "\uD55C\uC2DC\uB77C\uB3C4 \uBE68\uB9AC \uC800 \uC18C\uB984 \uB07C\uCE58\uB294
        \uC9D1\uACFC \uBA40\uC5B4\uC9C0\uACE0 \uC2F6\uC5C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4478153447547633519, guid: ca67ab3bea54e2742b915855d05d3155, type: 3}
      propertyPath: _dialogueLines.Array.data[2]._dialogue
      value: "\uB2EC\uB838\uB2E4. \uC228\uC774 \uD131 \uB05D\uAE4C\uC9C0 \uCC28\uC624\uB974\uACE0
        \uB2E4\uB9AC\uB294 \uC1F3\uB369\uC774\uCC98\uB7FC \uBB34\uAC70\uC6E0\uC9C0\uB9CC,
        \uD558\uB098\uB3C4 \uD798\uB4E4\uC9C0 \uC54A\uC558\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4478153447547633519, guid: ca67ab3bea54e2742b915855d05d3155, type: 3}
      propertyPath: _dialogueLines.Array.data[3]._dialogue
      value: "\uC544\uB2C8, \uD798\uB4E4\uB2E4\uB294 \uC774\uC720\uB85C \uBA48\uCD9C
        \uC218 \uC5C6\uC5C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4478153447547633519, guid: ca67ab3bea54e2742b915855d05d3155, type: 3}
      propertyPath: _dialogueLines.Array.data[4]._dialogue
      value: "\uADF8 \uC9D1\uACFC \uBA40\uC5B4\uC9C8 \uB54C\uAE4C\uC9C0, \uB098\uB294
        \uACC4\uC18D\uD574\uC11C \uB2EC\uB838\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4478153447547633519, guid: ca67ab3bea54e2742b915855d05d3155, type: 3}
      propertyPath: _dialogueLines.Array.data[5]._dialogue
      value: "\uC815\uC2E0\uC744 \uCC28\uB9AC\uB2C8 \uB530\uB73B\uD558\uACE0 \uC544\uB291\uD55C
        \uC6B0\uB9AC \uC9D1 \uD604\uAD00\uBB38 \uC55E\uC774\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4478153447547633519, guid: ca67ab3bea54e2742b915855d05d3155, type: 3}
      propertyPath: _dialogueLines.Array.data[6]._dialogue
      value: "\uBC18\uAC11\uB2E4. \uC544\uB291\uD55C \uC6B0\uB9AC \uC9D1\uC774\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4478153447547633519, guid: ca67ab3bea54e2742b915855d05d3155, type: 3}
      propertyPath: _dialogueLines.Array.data[7]._dialogue
      value: "\uD56D\uC0C1 \uB0A0 \uB9DE\uC774\uD558\uB358 \uC6B0\uB9AC \uC9D1 \uD604\uAD00\uBB38\uC774
        \uB208\uC5D0 \uB4E4\uC5B4\uC628 \uC21C\uAC04, \uB098\uB294 \uAE68\uB2EC\uC558\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4478153447547633519, guid: ca67ab3bea54e2742b915855d05d3155, type: 3}
      propertyPath: _dialogueLines.Array.data[8]._dialogue
      value: "\uADF8\uB9AC\uACE0 \uC6C3\uC5C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4478153447547633519, guid: ca67ab3bea54e2742b915855d05d3155, type: 3}
      propertyPath: _dialogueLines.Array.data[9]._dialogue
      value: "\uBA48\uCD94\uC9C0 \uC54A\uB294 \uC6C3\uC74C\uC744 \uB4A4\uB85C\uD55C
        \uCC44, \uB098\uB294 \uC9D1\uC758 \uBB38\uC744 \uC5F4\uC5C8\uB2E4."
