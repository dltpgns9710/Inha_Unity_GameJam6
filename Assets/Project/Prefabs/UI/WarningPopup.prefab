--- !u!114 &6800575872948771079
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1979885926367912238}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce83f284a8eac2d4fa916188bd573c57, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SEHOON.UI.WarningPopupView
  _messageText: "\uCF58\uD150\uCE20 \uACBD\uACE0 \\n\\n\uC774 \uAC8C\uC784\uC5D0\uB294
    \uB2E4\uC74C\uACFC \uAC19\uC740 \uC694\uC18C\uAC00 \uD3EC\uD568\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4.\\n\\n\uC608\uACE0
    \uC5C6\uC774 \uAC11\uC790\uAE30 \uB098\uD0C0\uB098\uB294 \uB180\uB77C\uB294 \uC7A5\uBA74
    \uD070 \uC18C\uB9AC\uB85C \uAC11\uC791\uC2A4\uB7FD\uAC8C \uC7AC\uC0DD\uB418\uB294
    \uD6A8\uACFC\uC74C\\n \uD610\uC624\uAC10\uC774\uB098 \uBD88\uCF8C\uAC10\uC744
    \uC904 \uC218 \uC788\uB294 \uAE30\uAD34\uD558\uACE0 \uADF8\uB85C\uD14C\uC2A4\uD06C\uD55C
    \uC774\uBBF8\uC9C0\\n \uAE34\uC7A5\uAC10\uACFC \uACF5\uD3EC\uAC10\uC744 \uC870\uC131\uD558\uB294
    \uC5F0\uCD9C\\n\\n \uC2EC\uC7A5 \uC9C8\uD658\uC774 \uC788\uAC70\uB098 \uD070
    \uC18C\uB9AC\uC640 \uAC11\uC791\uC2A4\uB7EC\uC6B4 \uC790\uADF9\uC5D0 \uBBFC\uAC10\uD558\uC2E0
    \uBD84, \uC784\uC0B0\uBD80, \uC5B4\uB9B0\uC774\uB294 \\n\uD50C\uB808\uC774\uC5D0
    \uC720\uC758\uD558\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4. \\n\\n\uD50C\uB808\uC774
    \uC911 \uBD88\uD3B8\uD568\uC774\uB098 \uC2A4\uD2B8\uB808\uC2A4\uB97C \uB290\uB07C\uC2E0\uB2E4\uBA74
    \uC989\uC2DC \uAC8C\uC784\uC744 \uC911\uB2E8\uD558\uC2DC\uAE38 \uAD8C\uC7A5\uD569\uB2C8\uB2E4."
  _displayDuration: 3
  _font: {fileID: 11400000, guid: 115feffced8cacd4e941cb6b98ccc7e4, type: 2}
  _messageTextWidget: {fileID: 3431527529923588616}
  _onDisableEvent:
    m_PersistentCalls:
      m_Calls: []
